name: easycopy
services:
  relay:
    image: ghcr.io/qmtdlt/easycopy-relay:@VERSION@
    platform: linux/amd64
    restart: unless-stopped
    ports:
      - "${EASYCOPY_PORT:-8443}:8443"
    volumes:
      - relay-data:/data
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    stop_grace_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
volumes:
  relay-data:
